# Copy this file to .env.local and fill in real values.
# Never commit .env.local or any file containing actual credentials.

# Example: API endpoint for the booking backend (when one is added)
# VITE_BOOKING_API_URL=https://api.example.com

# Example: analytics key — only add if you have a privacy-compliant analytics setup
# VITE_ANALYTICS_ID=

# NOTE: All VITE_* variables are inlined into the client bundle at build time
# and visible to end users. Do not place secrets here — only public-facing
# configuration values that are safe to expose.
